<Page
    x:Class="UserTrace.Views.GrupoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:UserTrace.Views"
    xmlns:models="using:UserTrace.Models"
    Background="Transparent">

    <Grid Margin="32,28,32,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <StackPanel Grid.Row="0" Spacing="2">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon
                    Glyph="&#xE902;"
                    FontSize="22"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    VerticalAlignment="Center"/>
                <TextBlock
                    Text="Busca por Grupo"
                    Style="{StaticResource TitleTextBlockStyle}"
                    VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock
                Text="Lista os grupos do domínio e exibe os membros de cada grupo."
                Style="{StaticResource PageDescriptionStyle}"/>
        </StackPanel>

        <!-- Barra de filtro -->
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox
                x:Name="FiltroTextBox"
                Grid.Column="0"
                PlaceholderText="Filtrar por nome do grupo (deixe vazio para listar todos)"
                KeyDown="FiltroTextBox_KeyDown"
                IsSpellCheckEnabled="False"
                FontFamily="Cascadia Mono, Consolas"
                VerticalAlignment="Center">
                <TextBox.Header>
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,4">
                        <FontIcon Glyph="&#xE721;" FontSize="12"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                  VerticalAlignment="Center"/>
                        <TextBlock Text="Nome do grupo (parcial ou vazio para todos)"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </TextBox.Header>
            </TextBox>

            <Button
                x:Name="ListarButton"
                Grid.Column="1"
                Style="{StaticResource AccentButtonStyle}"
                Click="ListarButton_Click"
                VerticalAlignment="Bottom"
                MinWidth="110">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE721;" FontSize="14"/>
                    <TextBlock Text="Buscar"/>
                </StackPanel>
            </Button>

            <Button
                x:Name="LimparButton"
                Grid.Column="2"
                Click="LimparButton_Click"
                VerticalAlignment="Bottom"
                MinWidth="90">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE894;" FontSize="14"/>
                    <TextBlock Text="Limpar"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Painel de 3 colunas: grupos → membros → detalhes -->
        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="200"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="260" MinWidth="200"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── COLUNA 1: Lista de grupos ── -->
            <Border Grid.Column="0" Style="{StaticResource MicaContentPanelStyle}">
                <Grid>
                    <ProgressRing
                        x:Name="GruposLoadingRing"
                        IsActive="False"
                        Visibility="Collapsed"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="40" Height="40"/>

                    <Grid x:Name="GruposPanel" RowSpacing="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Contador de grupos -->
                        <StackPanel
                            Grid.Row="0"
                            Orientation="Horizontal"
                            Spacing="6"
                            Margin="14,10,14,8">
                            <FontIcon
                                Glyph="&#xE902;"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                VerticalAlignment="Center"/>
                            <TextBlock
                                x:Name="GruposContadorText"
                                Text="Carregando…"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>

                        <ListView
                            x:Name="GruposListView"
                            Grid.Row="1"
                            SelectionChanged="GruposListView_SelectionChanged"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="4,0,4,8">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:GroupItem">
                                    <Grid ColumnSpacing="10" Padding="4,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Ícone do grupo -->
                                        <Border
                                            Grid.Column="0"
                                            Width="32" Height="32"
                                            CornerRadius="8"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            VerticalAlignment="Center">
                                            <FontIcon
                                                Glyph="&#xE902;"
                                                FontSize="14"
                                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock
                                                Text="{x:Bind Name}"
                                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                                TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <!-- Badge de tipo do grupo -->
                                                <Border
                                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="3"
                                                    Padding="5,1">
                                                    <TextBlock
                                                        Text="{x:Bind GroupType}"
                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                </Border>
                                                <TextBlock
                                                    Text="{x:Bind Description}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                    TextTrimming="CharacterEllipsis"
                                                    MaxWidth="140"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>
            </Border>

            <!-- Separador 1 -->
            <Rectangle Grid.Column="1" Style="{StaticResource FluentDividerStyle}"/>

            <!-- ── COLUNA 2: Membros do grupo selecionado ── -->
            <Border Grid.Column="2" Style="{StaticResource MicaContentPanelStyle}">
                <Grid>
                    <ProgressRing
                        x:Name="MembrosLoadingRing"
                        IsActive="False"
                        Visibility="Collapsed"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="40" Height="40"/>

                    <Grid x:Name="MembrosPanel" RowSpacing="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Cabeçalho da coluna de membros -->
                        <StackPanel Grid.Row="0" Margin="14,10,14,8" Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon
                                    Glyph="&#xE77B;"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    VerticalAlignment="Center"/>
                                <TextBlock
                                    x:Name="MembrosContadorText"
                                    Text="Selecione um grupo."
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <TextBlock
                                x:Name="GrupoSelecionadoText"
                                Text=""
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                TextTrimming="CharacterEllipsis"
                                Visibility="Collapsed"/>
                        </StackPanel>

                        <!-- Lista de membros -->
                        <ListView
                            x:Name="MembrosListView"
                            Grid.Row="1"
                            SelectionChanged="MembrosListView_SelectionChanged"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="4,0,4,8">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:SearchResultItem">
                                    <Grid ColumnSpacing="10" Padding="4,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Mini avatar -->
                                        <Border
                                            Grid.Column="0"
                                            Width="30" Height="30"
                                            CornerRadius="15"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            VerticalAlignment="Center">
                                            <FontIcon
                                                Glyph="&#xE77B;"
                                                FontSize="13"
                                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                            <TextBlock
                                                Text="{x:Bind DisplayName}"
                                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                                TextTrimming="CharacterEllipsis"/>
                                            <TextBlock
                                                Text="{x:Bind SamAccountName}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                FontFamily="Cascadia Mono, Consolas"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>
            </Border>

            <!-- Separador 2 -->
            <Rectangle Grid.Column="3" Style="{StaticResource FluentDividerStyle}"/>

            <!-- ── COLUNA 3: Detalhes do membro selecionado ── -->
            <Border Grid.Column="4" Style="{StaticResource MicaContentPanelStyle}">
                <Grid>
                    <ProgressRing
                        x:Name="DetalhesLoadingRing"
                        IsActive="False"
                        Visibility="Collapsed"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="48" Height="48"/>

                    <local:UserInfoPanel x:Name="DetalhesPanel"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>

</Page>
