<UserControl
    x:Class="UserTrace.Views.UserInfoPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:UserTrace.Views"
    xmlns:converters="using:UserTrace.Converters"
    Background="Transparent">

    <UserControl.Resources>
        <converters:HighlightedGroupToBrushConverter x:Key="HighlightedGroupToBrush"/>

        <!-- Badge de status: Sim (verde) / Não (vermelho) -->
        <Style x:Key="BadgeSimStyle" TargetType="Border">
            <Setter Property="Background"     Value="{ThemeResource SystemFillColorSuccessBackgroundBrush}"/>
            <Setter Property="BorderBrush"    Value="{ThemeResource SystemFillColorSuccessBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"   Value="4"/>
            <Setter Property="Padding"        Value="8,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="BadgeNaoStyle" TargetType="Border">
            <Setter Property="Background"     Value="{ThemeResource SystemFillColorCriticalBackgroundBrush}"/>
            <Setter Property="BorderBrush"    Value="{ThemeResource SystemFillColorCriticalBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"   Value="4"/>
            <Setter Property="Padding"        Value="8,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="BadgeNeutroStyle" TargetType="Border">
            <Setter Property="Background"     Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
            <Setter Property="BorderBrush"    Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"   Value="4"/>
            <Setter Property="Padding"        Value="8,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Chip de grupo -->
        <Style x:Key="GroupChipStyle" TargetType="Border">
            <Setter Property="Background"     Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
            <Setter Property="BorderBrush"    Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"   Value="12"/>
            <Setter Property="Padding"        Value="10,3"/>
            <Setter Property="Margin"         Value="0,0,6,6"/>
        </Style>

        <!-- Label de campo (não copiável; só valores são selecionáveis — ver UserInfoPanel.xaml.cs) -->
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock"
               BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground"
                    Value="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsTextSelectionEnabled" Value="False"/>
        </Style>

        <!-- Valor de campo: seleção é aplicada só nos TextBlocks permitidos em código -->
        <Style x:Key="FieldValueStyle" TargetType="TextBlock"
               BasedOn="{StaticResource BodyTextBlockStyle}">
            <Setter Property="VerticalAlignment"  Value="Center"/>
            <Setter Property="TextWrapping"       Value="Wrap"/>
            <Setter Property="IsTextSelectionEnabled" Value="False"/>
        </Style>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel
            x:Name="RootPanel"
            Spacing="12"
            Padding="20,16,20,20">

            <!-- ── ESTADO VAZIO ── -->
            <StackPanel
                x:Name="EmptyState"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12"
                Margin="0,60,0,0">
                <FontIcon
                    Glyph="&#xE77B;"
                    FontSize="48"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    HorizontalAlignment="Center"/>
                <TextBlock
                    x:Name="EmptyStateText"
                    Text="Informe um login e clique em Buscar."
                    Style="{StaticResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- ── CONTEÚDO DO USUÁRIO ── -->
            <StackPanel x:Name="ContentPanel" Spacing="12" Visibility="Collapsed">

                <!-- CARD: Identidade -->
                <Border Style="{StaticResource MicaCardStyle}">
                    <Grid RowSpacing="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Cabeçalho do card -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                Glyph="&#xE77B;"
                                FontSize="16"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                VerticalAlignment="Center"/>
                            <TextBlock
                                Text="Identidade"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Avatar + dados principais -->
                        <Grid Grid.Row="1" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Avatar circular -->
                            <Border
                                Grid.Column="0"
                                Width="56" Height="56"
                                CornerRadius="28"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                VerticalAlignment="Top">
                                <FontIcon
                                    Glyph="&#xE77B;"
                                    FontSize="24"
                                    Foreground="White"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                            </Border>

                            <!-- Nome e login -->
                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <TextBlock
                                    x:Name="FullNameText"
                                    Style="{StaticResource SubtitleTextBlockStyle}"
                                    TextTrimming="CharacterEllipsis"/>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon
                                        Glyph="&#xE716;"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        VerticalAlignment="Center"/>
                                    <TextBlock
                                        x:Name="SamText"
                                        Style="{StaticResource BodyTextBlockStyle}"
                                        FontFamily="Cascadia Mono, Consolas"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon
                                        Glyph="&#xE774;"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        VerticalAlignment="Center"/>
                                    <TextBlock
                                        x:Name="DomainText"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- CARD: Status da Conta -->
                <Border Style="{StaticResource MicaCardStyle}">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                Glyph="&#xE8D7;"
                                FontSize="16"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                VerticalAlignment="Center"/>
                            <TextBlock
                                Text="Status da conta"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                VerticalAlignment="Center"/>
                        </StackPanel>

                        <Grid ColumnSpacing="12" RowSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <!-- Conta ativa -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                                <TextBlock Text="Conta ativa" Style="{StaticResource FieldLabelStyle}"/>
                                <Border x:Name="ContaAtivaBadge">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon x:Name="ContaAtivaIcon" FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="ContaAtivaText" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Conta expira -->
                            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                                <TextBlock Text="Conta expira" Style="{StaticResource FieldLabelStyle}"/>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE787;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ContaExpiraText" Style="{StaticResource FieldValueStyle}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Senha expirada -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4">
                                <TextBlock Text="Senha expirada" Style="{StaticResource FieldLabelStyle}"/>
                                <Border x:Name="SenhaExpiradaBadge">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon x:Name="SenhaExpiradaIcon" FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="SenhaExpiradaText" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Requer smartcard -->
                            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                                <TextBlock Text="Requer smartcard" Style="{StaticResource FieldLabelStyle}"/>
                                <Border x:Name="SmartcardBadge">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon x:Name="SmartcardIcon" FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="SmartcardText" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- CARD: Senha -->
                <Border Style="{StaticResource MicaCardStyle}">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                Glyph="&#xE8D7;"
                                FontSize="16"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                VerticalAlignment="Center"/>
                            <TextBlock
                                Text="Senha"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                VerticalAlignment="Center"/>
                        </StackPanel>

                        <Grid ColumnSpacing="12" RowSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                                <TextBlock Text="Definida pela última vez" Style="{StaticResource FieldLabelStyle}"/>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE787;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="SenhaDefinidaText" Style="{StaticResource FieldValueStyle}"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                                <TextBlock Text="Expira" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBlock x:Name="SenhaExpiraText" Style="{StaticResource FieldValueStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4">
                                <TextBlock Text="Pode ser alterada" Style="{StaticResource FieldLabelStyle}"/>
                                <Border x:Name="SenhaAlteravelBadge">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon x:Name="SenhaAlteravelIcon" FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="SenhaAlteravelText" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                                <TextBlock Text="Obrigatória" Style="{StaticResource FieldLabelStyle}"/>
                                <Border x:Name="SenhaObrigBadge">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon x:Name="SenhaObrigIcon" FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="SenhaObrigText" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- CARD: Logon -->
                <Border Style="{StaticResource MicaCardStyle}">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                Glyph="&#xE8AF;"
                                FontSize="16"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                VerticalAlignment="Center"/>
                            <TextBlock
                                Text="Logon"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                VerticalAlignment="Center"/>
                        </StackPanel>

                        <Grid ColumnSpacing="12" RowSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                                <TextBlock Text="Último logon" Style="{StaticResource FieldLabelStyle}"/>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE787;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="UltimoLogonText" Style="{StaticResource FieldValueStyle}"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                                <TextBlock Text="Último logoff" Style="{StaticResource FieldLabelStyle}"/>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE787;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="UltimoLogoffText" Style="{StaticResource FieldValueStyle}"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4">
                                <TextBlock Text="Estações permitidas" Style="{StaticResource FieldLabelStyle}"/>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE7F8;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="EstacoesText" Style="{StaticResource FieldValueStyle}"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                                <TextBlock Text="Script de logon" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBlock x:Name="ScriptText" Style="{StaticResource FieldValueStyle}" FontFamily="Cascadia Mono, Consolas" FontSize="12"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Spacing="4">
                                <TextBlock Text="Perfil do usuário" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBlock x:Name="PerfilText" Style="{StaticResource FieldValueStyle}" FontFamily="Cascadia Mono, Consolas" FontSize="12"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="1" Spacing="4">
                                <TextBlock Text="Diretório base" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBlock x:Name="HomeDirText" Style="{StaticResource FieldValueStyle}" FontFamily="Cascadia Mono, Consolas" FontSize="12"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- CARD: Grupos Locais -->
                <Border Style="{StaticResource MicaCardStyle}">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                Glyph="&#xE902;"
                                FontSize="16"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                VerticalAlignment="Center"/>
                            <TextBlock
                                Text="Grupos locais"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                VerticalAlignment="Center"/>
                            <Border
                                x:Name="LocalGroupCountBadge"
                                Style="{StaticResource BadgeNeutroStyle}">
                                <TextBlock x:Name="LocalGroupCountText" Style="{StaticResource CaptionTextBlockStyle}"/>
                            </Border>
                        </StackPanel>
                        <ItemsControl x:Name="LocalGroupsList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="20"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource GroupChipStyle}"
                                            BorderBrush="{Binding Converter={StaticResource HighlightedGroupToBrush}}"
                                            ToolTipService.ToolTip="{Binding}">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <FontIcon Glyph="&#xE716;" FontSize="10"
                                                      Foreground="{Binding Converter={StaticResource HighlightedGroupToBrush}, ConverterParameter=Text}"
                                                      VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding}"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{Binding Converter={StaticResource HighlightedGroupToBrush}, ConverterParameter=Text}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- CARD: Grupos Globais -->
                <Border Style="{StaticResource MicaCardStyle}">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                Glyph="&#xE774;"
                                FontSize="16"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                VerticalAlignment="Center"/>
                            <TextBlock
                                Text="Grupos globais"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                VerticalAlignment="Center"/>
                            <Border
                                x:Name="GlobalGroupCountBadge"
                                Style="{StaticResource BadgeNeutroStyle}">
                                <TextBlock x:Name="GlobalGroupCountText" Style="{StaticResource CaptionTextBlockStyle}"/>
                            </Border>
                        </StackPanel>
                        <ItemsControl x:Name="GlobalGroupsList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="20"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource GroupChipStyle}"
                                            BorderBrush="{Binding Converter={StaticResource HighlightedGroupToBrush}}"
                                            ToolTipService.ToolTip="{Binding}">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <FontIcon Glyph="&#xE774;" FontSize="10"
                                                      Foreground="{Binding Converter={StaticResource HighlightedGroupToBrush}, ConverterParameter=Text}"
                                                      VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding}"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{Binding Converter={StaticResource HighlightedGroupToBrush}, ConverterParameter=Text}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>
        </StackPanel>
    </ScrollViewer>

</UserControl>
