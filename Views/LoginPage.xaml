<Page
    x:Class="UserTrace.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:UserTrace.Views"
    Background="Transparent">

    <Grid Margin="32,28,32,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <StackPanel Grid.Row="0" Spacing="2">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon
                    Glyph="&#xE77B;"
                    FontSize="22"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    VerticalAlignment="Center"/>
                <TextBlock
                    Text="Busca por Login"
                    Style="{StaticResource TitleTextBlockStyle}"
                    VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock
                    Text="Consulta os detalhes de um usuário pelo sAMAccountName."
                    Style="{StaticResource PageDescriptionStyle}"/>
        </StackPanel>

        <!-- Barra de busca -->
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox
                x:Name="LoginTextBox"
                Grid.Column="0"
                PlaceholderText="Digite o login (ex.: 0101010)"
                KeyDown="LoginTextBox_KeyDown"
                IsSpellCheckEnabled="False"
                FontFamily="Cascadia Mono, Consolas"
                VerticalAlignment="Center">
                <TextBox.Header>
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,4">
                        <FontIcon Glyph="&#xE716;" FontSize="12"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                  VerticalAlignment="Center"/>
                        <TextBlock Text="Login (sAMAccountName)"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </TextBox.Header>
            </TextBox>

            <Button
                x:Name="BuscarButton"
                Grid.Column="1"
                Style="{StaticResource AccentButtonStyle}"
                Click="BuscarButton_Click"
                VerticalAlignment="Bottom"
                MinWidth="110">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE721;" FontSize="14"/>
                    <TextBlock Text="Buscar"/>
                </StackPanel>
            </Button>

            <Button
                x:Name="LimparButton"
                Grid.Column="2"
                Click="LimparButton_Click"
                VerticalAlignment="Bottom"
                MinWidth="90">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE894;" FontSize="14"/>
                    <TextBlock Text="Limpar"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Área de resultado -->
        <Border Grid.Row="2" Style="{StaticResource MicaContentPanelStyle}">
            <Grid>
                <ProgressRing
                    x:Name="LoadingRing"
                    IsActive="False"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="48" Height="48"/>

                <local:UserInfoPanel x:Name="InfoPanel"/>
            </Grid>
        </Border>
    </Grid>

</Page>
