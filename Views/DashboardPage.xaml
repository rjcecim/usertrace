<Page
    x:Class="UserTrace.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI"
    Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto" ZoomMode="Disabled">
        <Grid Margin="32,28,32,24" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Cabeçalho -->
            <StackPanel Grid.Row="0" Spacing="2">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon
                        Glyph="&#xE9D2;"
                        FontSize="22"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        VerticalAlignment="Center"/>
                    <TextBlock
                        Text="Dashboard"
                        Style="{StaticResource TitleTextBlockStyle}"
                        VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock
                    Text="Visão geral das contas do Active Directory (bloqueios e expirações)."
                    Style="{StaticResource PageDescriptionStyle}"/>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                        <ProgressRing
                            x:Name="LoadingRing"
                            Width="20"
                            Height="20"
                            IsActive="False"
                            Visibility="Collapsed"/>
                        <TextBlock
                            x:Name="StatusTextBlock"
                            Text=""
                            Style="{StaticResource StatusCaptionStyle}"
                            Visibility="Collapsed"/>
                    </StackPanel>

                    <Button
                        x:Name="AtualizarButton"
                        Grid.Column="1"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="AtualizarButton_Click"
                        MinWidth="110">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Atualizar" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>

            <!-- KPIs -->
            <Grid Grid.Row="1" ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Contas Bloqueadas -->
                <Button
                    Grid.Row="0"
                    Grid.Column="0"
                    Style="{StaticResource MicaCardButtonStyle}"
                    Click="ContasBloqueadasCard_Click">
                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                        <StackPanel
                            Grid.Row="0"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                            <FontIcon
                                Glyph="&#xE72E;"
                                FontSize="14"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                VerticalAlignment="Center"/>
                            <TextBlock
                                Text="Contas Bloqueadas"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                TextWrapping="Wrap"
                                MaxLines="2"
                                TextTrimming="WordEllipsis"/>
                        </StackPanel>
                        <TextBlock
                            Grid.Row="2"
                            x:Name="KpiLockedCountTextBlock"
                            Text="—"
                            FontSize="36"
                            FontFamily="Cascadia Mono, Consolas"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Center"
                            TextAlignment="Center"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        <TextBlock
                            Grid.Row="1"
                            Text="LDAP com lockoutTime >= 1"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap"
                            MaxLines="2"
                            TextTrimming="WordEllipsis"/>
                    </Grid>
                </Button>

                <!-- Expiram hoje -->
                <Button
                    Grid.Row="0"
                    Grid.Column="1"
                    Style="{StaticResource MicaCardButtonStyle}"
                    Click="ExpiramHojeCard_Click">
                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                        <StackPanel
                            Grid.Row="0"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                            <FontIcon
                                Glyph="&#xE121;"
                                FontSize="14"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                VerticalAlignment="Center"/>
                            <TextBlock
                                Text="Contas que expiram hoje"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                TextWrapping="Wrap"
                                MaxLines="2"
                                TextTrimming="WordEllipsis"/>
                        </StackPanel>
                        <TextBlock
                            Grid.Row="2"
                            x:Name="KpiExpireTodayCountTextBlock"
                            Text="—"
                            FontSize="36"
                            FontFamily="Cascadia Mono, Consolas"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Center"
                            TextAlignment="Center"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        <TextBlock
                            Grid.Row="1"
                            Text="Pela política de senha do domínio"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap"
                            MaxLines="2"
                            TextTrimming="WordEllipsis"/>
                    </Grid>
                </Button>

                <!-- Expiram em 1 semana -->
                <Button
                    Grid.Row="1"
                    Grid.Column="0"
                    Style="{StaticResource MicaCardButtonStyle}"
                    Click="ExpiramEmUmaSemanaCard_Click">
                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                        <StackPanel
                            Grid.Row="0"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                            <FontIcon
                                Glyph="&#xE121;"
                                FontSize="14"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                VerticalAlignment="Center"/>
                            <TextBlock
                                Text="Contas que expiram em 1 semana"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                TextWrapping="Wrap"
                                MaxLines="2"
                                TextTrimming="WordEllipsis"/>
                        </StackPanel>
                        <TextBlock
                            Grid.Row="2"
                            x:Name="KpiExpireInWeekCountTextBlock"
                            Text="—"
                            FontSize="36"
                            FontFamily="Cascadia Mono, Consolas"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Center"
                            TextAlignment="Center"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        <TextBlock
                            Grid.Row="1"
                            Text="Hoje e os próximos 6 dias (7 dias)"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap"
                            MaxLines="2"
                            TextTrimming="WordEllipsis"/>
                    </Grid>
                </Button>

                <!-- Troca próximo logon -->
                <Button
                    Grid.Row="1"
                    Grid.Column="1"
                    Style="{StaticResource MicaCardButtonStyle}"
                    Click="TrocaProximoLogonCard_Click">
                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                        <StackPanel
                            Grid.Row="0"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                            <FontIcon
                                Glyph="&#xE121;"
                                FontSize="14"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                VerticalAlignment="Center"/>
                            <TextBlock
                                Text="Troca no próximo logon"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                TextWrapping="Wrap"
                                MaxLines="2"
                                TextTrimming="WordEllipsis"/>
                        </StackPanel>
                        <TextBlock
                            Grid.Row="2"
                            x:Name="KpiMustChangeNextLogonCountTextBlock"
                            Text="—"
                            FontSize="36"
                            FontFamily="Cascadia Mono, Consolas"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Center"
                            TextAlignment="Center"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        <TextBlock
                            Grid.Row="1"
                            Text="LDAP com pwdLastSet = 0"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap"
                            MaxLines="2"
                            TextTrimming="WordEllipsis"/>
                    </Grid>
                </Button>
            </Grid>

            <!-- Gráfico 1: distribuição diária -->
            <Border Grid.Row="2" Style="{StaticResource MicaCardStyle}">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon
                                Glyph="&#xE9D9;"
                                FontSize="16"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                VerticalAlignment="Center"/>
                            <TextBlock
                                Text="Expirações (distribuição diária)"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock
                            Text="Hoje e os próximos 6 dias (7 dias)."
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap"
                            MaxLines="2"
                            TextTrimming="WordEllipsis"/>
                    </StackPanel>

                    <lvc:CartesianChart
                        x:Name="ExpiracoesPorDiaChart"
                        Grid.Row="1"
                        MinHeight="220"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"/>
                </Grid>
            </Border>

            <!-- Gráfico 2: Hoje vs Próximos dias -->
            <Border Grid.Row="3" Style="{StaticResource MicaCardStyle}">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon
                                Glyph="&#xE9DA;"
                                FontSize="16"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                VerticalAlignment="Center"/>
                            <TextBlock
                                Text="Hoje vs Próximos dias"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                VerticalAlignment="Center"
                                TextWrapping="Wrap"
                                MaxLines="1"
                                TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <TextBlock
                            Text="Comparação dentro da mesma janela (7 dias)."
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap"
                            MaxLines="2"
                            TextTrimming="WordEllipsis"/>
                    </StackPanel>

                    <lvc:CartesianChart
                        x:Name="ExpireHojeVsProximosChart"
                        Grid.Row="1"
                        MinHeight="220"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"/>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>

