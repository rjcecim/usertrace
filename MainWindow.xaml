<winuiex:WindowEx
    x:Class="UserTrace.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:UserTrace"
    xmlns:models="using:UserTrace.Models"
    xmlns:winuiex="using:WinUIEx"
    Title="UserTrace">

    <!--
        MICA BEST PRACTICE #1 — Background da raiz DEVE ser Transparent.
        Qualquer cor sólida aqui bloqueia o Mica de aparecer.
    -->
    <Grid Background="Transparent" PreviewKeyDown="Root_PreviewKeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Faixa da barra de título: o fundo quase invisível recebe o arraste. A busca continua clicável. -->
        <Grid x:Name="TitleBarHost" Grid.Row="0">
            <Grid.Background>
                <SolidColorBrush Color="#01FFFFFF"/>
            </Grid.Background>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TitleBarPaneColumn" Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="1" Margin="16,0,148,0" VerticalAlignment="Center">
                <Grid HorizontalAlignment="Center" Width="520" MaxWidth="560">
                    <AutoSuggestBox
                        x:Name="GlobalSearchBox"
                        PlaceholderText="Buscar usuários, grupos, logins, setores..."
                        QueryIcon="Find"
                        CornerRadius="16"
                        TextMemberPath="Title"
                        UpdateTextOnSelect="False"
                        TextChanged="GlobalSearchBox_TextChanged"
                        SuggestionChosen="GlobalSearchBox_SuggestionChosen"
                        QuerySubmitted="GlobalSearchBox_QuerySubmitted">
                        <AutoSuggestBox.ItemTemplate>
                            <DataTemplate x:DataType="models:GlobalSearchHit">
                                <Grid Width="460" Padding="0,4" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Text="{x:Bind Kind}"
                                        FontSize="11"
                                        Foreground="{ThemeResource DashboardMutedBrush}"
                                        VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Title}" FontSize="14"/>
                                        <TextBlock
                                            Text="{x:Bind Subtitle}"
                                            FontSize="12"
                                            Foreground="{ThemeResource DashboardMutedBrush}"
                                            TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </AutoSuggestBox.ItemTemplate>
                    </AutoSuggestBox>
                    <Border
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,36,0"
                        Padding="6,2"
                        CornerRadius="4"
                        Background="{ThemeResource DashboardBadgeGrayBrush}"
                        IsHitTestVisible="False">
                        <TextBlock
                            Text="Ctrl + K"
                            FontSize="11"
                            Foreground="{ThemeResource DashboardMutedBrush}"/>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="Left"
            OpenPaneLength="220"
            SelectionChanged="NavView_SelectionChanged"
            IsPaneToggleButtonVisible="True"
            IsTitleBarAutoPaddingEnabled="False">

            <!--
                MICA BEST PRACTICE #2 — Header customizado dentro do NavigationView.
                Isso permite que o PaneHeader fique alinhado com a TitleBar,
                criando o efeito de "painel lateral integrado" característico
                de apps como Settings e Files do Windows 11.
            -->
            <NavigationView.PaneHeader>
                <StackPanel Margin="16,4,16,8" Spacing="6">
                    <!-- Logo + nome do app -->
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Image
                            Source="ms-appx:///Assets/app_icon.png"
                            Width="32" Height="32"
                            Stretch="Uniform"
                            VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center" Spacing="1">
                            <TextBlock
                                Text="UserTrace"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <TextBlock
                                Text="Active Directory"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </NavigationView.PaneHeader>

            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Name="NavItemDashboard"
                    Content="Dashboard"
                    Tag="Dashboard">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D2;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem
                    x:Name="NavItemLogin"
                    Content="Busca por Login"
                    Tag="Login">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE77B;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem
                    x:Name="NavItemNome"
                    Content="Busca por Nome"
                    Tag="Nome">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE721;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem
                    x:Name="NavItemGrupo"
                    Content="Busca por Grupo"
                    Tag="Grupo">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE902;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem
                    x:Name="NavItemSetor"
                    Content="Busca por Setor"
                    Tag="Setor">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B7;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem
                    x:Name="NavItemSenhasExpiradas"
                    Content="Senhas Expiradas"
                    Tag="SenhasExpiradas">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE121;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem
                    x:Name="NavItemContasBloqueadas"
                    Content="Contas Bloqueadas"
                    Tag="ContasBloqueadas">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE72E;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem
                    x:Name="NavItemContasDesativadas"
                    Content="Contas Desativadas"
                    Tag="ContasDesativadas">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE711;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem
                    x:Name="NavItemSobre"
                    Content="Sobre"
                    Tag="Sobre">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <NavigationView.PaneFooter>
                <StackPanel Margin="16,4,16,16" Spacing="6">
                    <TextBlock
                        x:Name="VersionText"
                        Text="UserTrace"
                        FontSize="12"
                        Foreground="{ThemeResource DashboardMutedBrush}"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse
                            x:Name="ConnectionDot"
                            Width="8"
                            Height="8"
                            VerticalAlignment="Center"
                            Fill="{ThemeResource DashboardMutedBrush}"/>
                        <TextBlock
                            x:Name="ConnectionText"
                            Text="Verificando AD…"
                            FontSize="12"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource DashboardMutedBrush}"/>
                    </StackPanel>
                </StackPanel>
            </NavigationView.PaneFooter>

            <!--
                MICA BEST PRACTICE #3 — Frame com Background Transparent.
                O conteúdo das Pages "flutua" sobre o Mica sem bloquear o efeito.
            -->
            <Frame x:Name="ContentFrame" Background="Transparent"/>
        </NavigationView>
    </Grid>

</winuiex:WindowEx>
